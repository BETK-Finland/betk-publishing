        <di:waypoint x="920" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1ko6j2h_di" bpmnElement="Flow_1ko6j2h">
        <di:waypoint x="420" y="180" />
