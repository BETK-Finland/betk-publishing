---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../data/nav";
import { listMedia } from "../data/media-loader";
import morko from "../assets/morko.png";

const docsHref = withBase("soveltamisohje/tarjousvaiheen-tietomaaritykset");
const propertiesHref = withBase("properties");
const peppolHref = withBase("peppol");
const mediaHref = withBase("media");

const TILE_SHAPES = [
  "full",
  "full",
  "half",
  "half",
  "wide",
  "half",
  "small",
  "small",
  "wide",
] as const;

const recentMedia = (await listMedia()).slice(0, 9).map((post, index) => {
  const excerpt = (post.body ?? "")
    .split("\n")
    .map((line) => line.trim())
    .find((line) => line.length > 0 && !line.startsWith("<") && !line.startsWith("["));
  const shape = TILE_SHAPES[index] ?? "half";
  const showExcerpt = shape === "full" || shape === "wide";
  return {
    id: post.id,
    href: withBase(`media/${post.id}`),
    title: post.data.title,
    date: post.data.date,
    excerpt: showExcerpt ? excerpt : undefined,
    shape,
  };
});

const topics = [
  {
    href: docsHref,
    title: "Soveltamisohjeet",
    i18nKey: "nav.documents",
    blurbKey: "home.cardGuides",
    mark: "guide",
    blurb:
      "Tietomääritykset ja soveltamisohjeet toimialan käyttöön. Tarjousvaihe, tuoteyksilöinti ja tunnistaminen.",
  },
  {
    href: propertiesHref,
    title: "BIM / IFC",
    blurbKey: "home.cardBim",
    mark: "standard",
    blurb:
      "Vakioidut ominaisuudet ja ominaisuusryhmät sallittuine arvoineen. Koneluettava tietopohja suunnittelusta työmaalle.",
  },
  {
    href: peppolHref,
    title: "Peppol",
    i18nKey: "nav.peppol",
    blurbKey: "home.cardPeppol",
    mark: "peppol",
    blurb:
      "Standardoituja sanomia ja asiakirjoja prosessivaiheiden tiedonvälitykseen. Neljän kulman malli, yksilöllinen Peppol-tunnus.",
  },
] as const;
---

<Layout
  title="BETK — Betonielementin toimitusketju"
  description="Standardoidut tietomäärittelyt rakennustuotteille"
>
  <main id="main">
    <section class="hero">
      <h1>
        <span>BETK</span>
        <span data-i18n="home.name">Betonielementin toimitusketju</span>
      </h1>
      <p class="lead">
        <span data-i18n="home.description">Standardoidut tietomäärittelyt rakennustuotteille</span>
        <span data-i18n="home.lead">
          Sivuston tarkoitus on tarjota suunnittelijoille, urakoitsijoille ja
          elementtitoimittajille yhteinen, koneluettava tietopohja
          rakennushankkeiden tietomallintamiseen ja osapuolien väliseen
          tiedonsiirtoon.
        </span>
      </p>
    </section>

    <section class="topics" id="what">
      <h2 data-i18n="home.focus">Painopisteet</h2>
      <ul class="cards">
        {
          topics.map((topic) => (
            <li>
              <a class="card" href={topic.href}>
                {topic.mark === "guide" && (
                  <svg class="logo" viewBox="0 0 64 64" aria-hidden="true">
                    <rect x="14" y="10" width="36" height="44" rx="4" fill="none" stroke="currentColor" stroke-width="2"></rect>
                    <path d="M22 22h20M22 30h20M22 38h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                  </svg>
                )}
                {topic.mark === "standard" && (
                  <svg class="logo" viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="32" r="18" fill="none" stroke="currentColor" stroke-width="2"></circle>
                    <path d="M32 18v28M18 32h28" fill="none" stroke="currentColor" stroke-width="2"></path>
                    <circle cx="32" cy="32" r="5" fill="currentColor"></circle>
                  </svg>
                )}
                {topic.mark === "peppol" && (
                  <svg class="logo" viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="18" cy="20" r="5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                    <circle cx="46" cy="20" r="5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                    <circle cx="32" cy="44" r="5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                    <path d="M22.5 23.5 28.5 40M41.5 23.5 35.5 40M23 20h18" fill="none" stroke="currentColor" stroke-width="2"></path>
                  </svg>
                )}
                <h3 data-i18n={"i18nKey" in topic ? topic.i18nKey : undefined}>{topic.title}</h3>
                <p data-i18n={topic.blurbKey}>{topic.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      recentMedia.length > 0 && (
        <section class="media-home" id="media">
          <h2 data-i18n="home.latest">Ajankohtaista</h2>
          <ul class="media-mosaic">
            {recentMedia.map((item, index) => (
              <li class={`media-cell shape-${item.shape} slot-${index}`}>
                <a class="media-tile" href={item.href}>
                  <h3>{item.title}</h3>
                  {item.date && (
                    <p class="media-date">
                      <time datetime={item.date.toISOString().slice(0, 10)}>
                        {item.date.toLocaleDateString("fi-FI")}
                      </time>
                    </p>
                  )}
                  {item.excerpt && <p class="media-excerpt">{item.excerpt}</p>}
                </a>
              </li>
            ))}
          </ul>
          <p class="media-all">
            <a href={mediaHref} data-i18n="home.mediaAll">
              Kaikki media
            </a>
          </p>
        </section>
      )
    }

    <section class="architecture" id="architecture">
      <h2 data-i18n="home.archTitle">Hajautettu ja avoin ETO-arkkitehtuuri</h2>
      <p class="arch-lead" data-i18n="home.archLead">
        Digitalisoidun elementtitoimitusketjun tietovarannot, rajapinnat ja
        prosessin tärkeimmät toiminnot
      </p>
      <div class="arch-frame">
        <img
          src={morko.src}
          width={morko.width}
          height={morko.height}
          alt="Tiedonvirtauksen arkkitehtuurikuvaus: rakennusalan projektituotteen (ETO) tavoitetila"
          data-i18n-alt="home.archAlt"
        />
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 58rem;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2.2rem 0 2.4rem;
    text-align: center;
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 0 0.85rem;
    font-size: clamp(1.55rem, 3.2vw, 2.1rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .lead {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    margin: 0;
  }

  .topics {
    padding: 2.2rem 0 2.8rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 4.6rem;
  }

  .topics h2 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 600;
    text-align: center;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 18rem;
    padding: 1.8rem 1.15rem 1.5rem;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
  }

  .card:hover {
    text-decoration: none;
  }

  .logo {
    width: 4.8rem;
    height: 4.8rem;
    flex-shrink: 0;
    margin: 0 0 0.9rem;
    color: var(--accent);
  }

  .card h3 {
    margin: 0 0 0.7rem;
    font-size: 1.12rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.25;
  }

  .card p {
    flex: 1;
    margin: 0;
    min-height: 4.2em;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.4;
    text-align: center;
  }

  .media-home {
    padding: 2.2rem 0 2.8rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 4.6rem;
  }

  .media-home h2 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 600;
    text-align: center;
  }

  .media-mosaic {
    --gap: 1.15rem;
    --full-h: 18rem;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: calc((var(--full-h) - var(--gap)) / 2);
    grid-template-areas:
      "a a b b c c"
      "a a b b d d"
      "e e e e f f"
      "g h i i i i";
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .slot-0 { grid-area: a; }
  .slot-1 { grid-area: b; }
  .slot-2 { grid-area: c; }
  .slot-3 { grid-area: d; }
  .slot-4 { grid-area: e; }
  .slot-5 { grid-area: f; }
  .slot-6 { grid-area: g; }
  .slot-7 { grid-area: h; }
  .slot-8 { grid-area: i; }

  .media-cell {
    min-width: 0;
    min-height: 0;
  }

  .media-tile {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 1rem 1.05rem;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    overflow: hidden;
  }

  .shape-full .media-tile {
    padding: 1.8rem 1.15rem 1.5rem;
  }

  .shape-wide .media-tile {
    padding: 1rem 1.4rem;
  }

  .shape-small .media-tile {
    padding: 0.65rem 0.7rem;
  }

  .media-tile:hover {
    text-decoration: none;
  }

  .media-tile:hover h3 {
    color: var(--accent);
  }

  .media-tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .media-tile h3 {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.25;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .shape-full .media-tile h3 {
    margin: 0 0 0.55rem;
    font-size: 1.12rem;
    -webkit-line-clamp: 4;
  }

  .shape-half .media-tile h3 {
    -webkit-line-clamp: 2;
  }

  .shape-wide .media-tile h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    -webkit-line-clamp: 2;
  }

  .shape-small .media-tile h3 {
    font-size: 0.78rem;
    font-weight: 600;
    -webkit-line-clamp: 4;
  }

  .media-date {
    flex: 0 0 auto;
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .shape-full .media-date {
    margin: 0 0 0.55rem;
  }

  .shape-small .media-date {
    margin: 0.25rem 0 0;
    font-size: 0.68rem;
  }

  .media-excerpt {
    display: -webkit-box;
    flex: 0 0 auto;
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .shape-wide .media-excerpt {
    -webkit-line-clamp: 1;
  }

  .media-all {
    margin: 1.1rem 0 0;
    text-align: center;
  }

  .media-all a {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .architecture {
    padding: 2.2rem 0 2.8rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 4.6rem;
  }

  .architecture h2 {
    margin: 0 0 0.7rem;
    font-size: 1.2rem;
    font-weight: 600;
    text-align: center;
  }

  .arch-lead {
    max-width: 36rem;
    margin: 0 auto 1.4rem;
    color: var(--muted);
    font-size: 0.95rem;
    text-align: center;
  }

  .arch-frame {
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
  }

  .arch-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 800px) {
    .media-mosaic {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 8rem;
      grid-template-areas:
        "a a"
        "b b"
        "c d"
        "e e"
        "f g"
        "h i";
    }

    .media-tile {
      justify-content: flex-start;
    }

    .shape-full .media-tile,
    .shape-wide .media-tile {
      padding: 1.1rem 1.2rem;
    }

    .shape-full .media-tile h3,
    .shape-wide .media-tile h3 {
      -webkit-line-clamp: 3;
    }
  }

  @media (max-width: 520px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .media-mosaic {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      grid-template-areas: none;
    }

    .media-cell {
      grid-area: auto;
    }

    .media-tile {
      min-height: 0;
      padding: 1rem 1.05rem;
    }

    .shape-full .media-tile,
    .shape-wide .media-tile,
    .shape-small .media-tile {
      padding: 1rem 1.05rem;
    }

    .shape-full .media-tile h3,
    .shape-half .media-tile h3,
    .shape-wide .media-tile h3,
    .shape-small .media-tile h3 {
      font-size: 1rem;
      -webkit-line-clamp: 5;
    }
  }
</style>
