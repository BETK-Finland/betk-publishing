---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SoveltamisohjeHeader from "../../components/SoveltamisohjeHeader.astro";
import SoveltamisohjeToc from "../../components/SoveltamisohjeToc.astro";
import PrintToc from "../../components/PrintToc.astro";
import ProseSection from "../../components/ProseSection.astro";
import DataTable from "../../components/DataTable.astro";
import ReinforcementTable from "../../components/ReinforcementTable.astro";
import GenericDataTable from "../../components/GenericDataTable.astro";
import { getDoc, listDocs, translationsOf, fallbackLangs } from "../../data/soveltamisohje-loader";
import { sovLang, sovStrings, dateLocale } from "../../data/soveltamisohje-i18n";
import type {
  ValueTable,
  PintakasittelyTable,
  Lyhenteet,
  RaudoitusEsimerkit,
  Gs1AiTaulukot,
  GenericTaulukot,
} from "../../data/soveltamisohje-types";

export async function getStaticPaths() {
  return listDocs().map(d => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const doc = getDoc(slug!);
const { meta, manifest, tables } = doc;
const allDocs = listDocs();
const base = import.meta.env.BASE_URL;
const lang = sovLang(manifest.lang);
const t = sovStrings(lang);
// lang -> URL of this guide's translations, used to follow the site language switch.
const translationUrls = Object.fromEntries(
  Object.entries(translationsOf(slug!)).map(([l, s]) => [l, `${base}soveltamisohje/${s}`]),
);

// Collection entries for this doc; entry ids are "<slug>/<filename-without-ext>".
const allEntries = await getCollection("soveltamisohje");
const entries = allEntries.filter(e => e.id.startsWith(`${slug}/`));

function getEntry(shortName: string) {
  return entries.find(e => e.id === `${slug}/${shortName}`);
}

// Resolve each manifest section into a renderable record. Prose sections
// eagerly render their markdown so Astro can emit components in one pass.
type Rendered =
  | {
      kind: "prose";
      anchor: string;
      sectionNumber: string;
      title: string;
      Content: any;
    }
  | {
      kind: "prose+table";
      anchor: string;
      sectionNumber: string;
      title: string;
      Content: any;
      table: ValueTable;
    }
  | {
      kind: "prose+pintakasittely";
      anchor: string;
      sectionNumber: string;
      title: string;
      Content: any;
      table: PintakasittelyTable;
    }
  | {
      kind: "prose+gs1tables";
      anchor: string;
      sectionNumber: string;
      title: string;
      Content: any;
      data: Gs1AiTaulukot;
    }
  | {
      kind: "prose+generictables";
      anchor: string;
      sectionNumber: string;
      title: string;
      Content: any;
      data: GenericTaulukot;
    }
  | { kind: "glossary"; anchor: string; label: string; heading: string; data: Lyhenteet }
  | { kind: "reinforcement-annex"; anchor: string; label: string; heading: string; data: RaudoitusEsimerkit };

async function resolveSection(section: typeof manifest.sections[number]): Promise<Rendered | null> {
  if (section.kind === "prose" || section.kind === "prose+table" || section.kind === "prose+pintakasittely" || section.kind === "prose+gs1tables" || section.kind === "prose+generictables") {
    const entry = getEntry(section.content!);
    if (!entry) return null;
    const { Content } = await render(entry);
    const base = {
      anchor: section.anchor,
      sectionNumber: entry.data.section,
      title: entry.data.title,
      Content,
    };
    if (section.kind === "prose") return { kind: "prose", ...base };
    if (section.kind === "prose+table") {
      const table = tables[section.table!] as ValueTable | undefined;
      if (!table) return null;
      return { kind: "prose+table", ...base, table };
    }
    if (section.kind === "prose+gs1tables") {
      const data = tables[section.table!] as unknown as Gs1AiTaulukot | undefined;
      if (!data) return null;
      return { kind: "prose+gs1tables", ...base, data };
    }
    if (section.kind === "prose+generictables") {
      const data = tables[section.table!] as unknown as GenericTaulukot | undefined;
      if (!data) return null;
      return { kind: "prose+generictables", ...base, data };
    }
    const pkTable = tables[section.table!] as PintakasittelyTable | undefined;
    if (!pkTable) return null;
    return { kind: "prose+pintakasittely", ...base, table: pkTable };
  }
  if (section.kind === "glossary") {
    const data = tables[section.data!] as Lyhenteet | undefined;
    if (!data) return null;
    const label = section.label ?? t.glossary;
    return { kind: "glossary", anchor: section.anchor, label, heading: section.heading ?? label, data };
  }
  if (section.kind === "reinforcement-annex") {
    const data = tables[section.data!] as RaudoitusEsimerkit | undefined;
    if (!data) return null;
    const label = section.label ?? t.annex;
    return { kind: "reinforcement-annex", anchor: section.anchor, label, heading: section.heading ?? label, data };
  }
  return null;
}

const resolved = (await Promise.all(manifest.sections.map(resolveSection))).filter(
  (r): r is Rendered => r !== null,
);

// TOC items: prose sections get "<section> <title>"; others use manifest label.
// Sections with empty sectionNumber+title (continuation blocks) are excluded from TOC.
const tocItems = resolved.flatMap(r => {
  if (r.kind === "prose" || r.kind === "prose+table" || r.kind === "prose+pintakasittely" || r.kind === "prose+gs1tables" || r.kind === "prose+generictables") {
    if (!r.sectionNumber && !r.title) return [];
    return [{ anchor: r.anchor, label: `${r.sectionNumber} ${r.title}`.trim() }];
  }
  return [{ anchor: r.anchor, label: r.label }];
});
---

<Layout title={`BETK — ${meta.otsikko}`} description={meta.alaotsikko ?? meta.otsikko}>
  <main id="main" class="sov-layout">
    <div class="sov-sidebar">
      <nav class="sov-doc-nav" aria-label={t.documents}>
        <p class="sidebar-heading" data-i18n="docs.heading">DOKUMENTIT</p>
        <ul class="sov-toc-list">
          {allDocs.map(d => (
            <li data-sov-lang={d.manifest.lang ?? "fi"} data-sov-fallback={fallbackLangs(d.slug).join(" ")}>
              <a
                href={`${base}soveltamisohje/${d.slug}`}
                class={`sov-toc-link${d.slug === slug ? " active" : ""}`}
              >{d.manifest.nav_title}</a>
            </li>
          ))}
        </ul>
      </nav>
      <SoveltamisohjeToc items={tocItems} label={t.toc} />
    </div>
    <article class="sov-document" lang={lang} data-sov-translations={JSON.stringify(translationUrls)} data-sov-doc-lang={lang} data-sov-printed={t.printed} data-sov-locale={dateLocale[lang]}>
      <SoveltamisohjeHeader meta={meta} lang={lang} />
      <PrintToc sections={tocItems} heading={t.toc} />

      {resolved.map(r => {
        if (r.kind === "prose") {
          return (
            <ProseSection id={r.anchor} sectionNumber={r.sectionNumber} title={r.title}>
              <r.Content />
            </ProseSection>
          );
        }
        if (r.kind === "prose+table" || r.kind === "prose+pintakasittely") {
          return (
            <div>
              <ProseSection id={r.anchor} sectionNumber={r.sectionNumber} title={r.title}>
                <r.Content />
              </ProseSection>
              <DataTable table={r.table} lang={lang} />
            </div>
          );
        }
        if (r.kind === "prose+gs1tables") {
          return (
            <div>
              <ProseSection id={r.anchor} sectionNumber={r.sectionNumber} title={r.title}>
                <r.Content />
              </ProseSection>
              {r.data.taulukot.map(tb => (
                <div class="sov-gs1-table">
                  <p class="sov-table-number">{t.table} {tb.taulukonNumero}. {tb.otsikko}</p>
                  <table class="sov-values-table">
                    <caption class="sr-only">{t.table} {tb.taulukonNumero}. {tb.otsikko}</caption>
                    <thead>
                      <tr>
                        <th>{t.ai}</th>
                        <th>{t.data}</th>
                        <th>{t.example}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {tb.rivit.map(r => (
                        <tr>
                          <td><code>{r.ai}</code></td>
                          <td>{r.tieto}</td>
                          <td><code>{r.esimerkki}</code></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ))}
            </div>
          );
        }
        if (r.kind === "prose+generictables") {
          return (
            <div>
              <ProseSection id={r.anchor} sectionNumber={r.sectionNumber} title={r.title}>
                <r.Content />
              </ProseSection>
              <GenericDataTable data={r.data} lang={lang} />
            </div>
          );
        }
        if (r.kind === "glossary") {
          return (
            <section id={r.anchor} class="sov-section">
              <h2>{r.heading}</h2>
              <table class="sov-glossary-table">
                <tbody>
                  {r.data.termit.map(t => (
                    <tr>
                      <td><strong>{t.termi}</strong></td>
                      <td>{t.selite}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          );
        }
        if (r.kind === "reinforcement-annex") {
          return (
            <section id={r.anchor} class="sov-section">
              <h2>{r.heading}</h2>
              {r.data.selite && <p class="sov-prose">{r.data.selite}</p>}
              {r.data.taulukot.map(t => (
                <ReinforcementTable table={t} />
              ))}
            </section>
          );
        }
        return null;
      })}
    </article>
  </main>
</Layout>


<script>
  // Print date stamp — set on beforeprint, visible only in print CSS
  const article = document.querySelector<HTMLElement>(".sov-document");
  const el = document.querySelector(".sov-print-date");
  if (el && article) {
    const printed = article.dataset.sovPrinted ?? "Tulostettu";
    const locale = article.dataset.sovLocale ?? "fi-FI";
    window.addEventListener("beforeprint", () => {
      el.textContent = `${printed}: ${new Date().toLocaleDateString(locale)}`;
    });
  }

  // Follow the site language: open this guide's translation when one exists.
  // On load only when the visitor has chosen a language, so a shared link to
  // a translation still opens as-is for first-time visitors.
  if (article) {
    const urls: Record<string, string> = JSON.parse(article.dataset.sovTranslations ?? "{}");
    const docLang = article.dataset.sovDocLang;
    const go = (lang: string | null) => {
      if (lang && lang !== docLang && urls[lang]) {
        location.replace(urls[lang] + location.hash);
      }
    };
    let stored: string | null = null;
    try { stored = localStorage.getItem("betk-lang"); } catch {}
    go(stored);
    window.addEventListener("betk-lang-change", e => go((e as CustomEvent).detail));
  }
  // Force all <details> open before print
  window.addEventListener("beforeprint", () => {
    document.querySelectorAll("details").forEach(d => d.setAttribute("open", ""));
  });
</script>
