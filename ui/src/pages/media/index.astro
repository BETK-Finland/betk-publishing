---
import Layout from "../../layouts/Layout.astro";
import MediaSidebar from "../../components/MediaSidebar.astro";
import { listMedia } from "../../data/media-loader";
import { withBase } from "../../data/nav";

const posts = await listMedia();

const items = posts.map((post) => {
  const video = post.body?.match(
    /youtube-nocookie\.com\/embed\/([A-Za-z0-9_-]+)/,
  )?.[1];
  const excerpt = (post.body ?? "")
    .split("\n")
    .map((line) => line.trim())
    .find((line) => line.length > 0 && !line.startsWith("<") && !line.startsWith("["));
  return { id: post.id, title: post.data.title, date: post.data.date, video, excerpt };
});

const navItems = posts.map((item) => ({ id: item.id, title: item.data.title }));
---

<Layout
  title="Media — BETK"
  description="Artikkelit, blogitekstit, webinaarit ja julkaisut, joissa BETK on ollut esillä."
>
  <main id="main" class="sov-layout">
    <MediaSidebar items={navItems} />
    <article class="sov-document">
      <header class="sov-header">
        <p class="mark" data-i18n="nav.media">Media</p>
        <h1 class="sov-title" data-i18n="nav.media">Media</h1>
        <p class="sov-subtitle">
          Artikkelit, blogitekstit, webinaarit ja julkaisut, joissa BETK on
          ollut esillä. Uusin ylimpänä.
        </p>
      </header>

      <ul class="media-list">
        {
          items.map((item) => (
            <li class="media-item">
              {item.video && (
                <div class="media-thumb">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${item.video}`}
                    title={item.title}
                    loading="lazy"
                    allowfullscreen
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  />
                </div>
              )}
              <div class="media-body">
                <h2 class="media-title">
                  <a href={withBase(`media/${item.id}`)}>{item.title}</a>
                </h2>
                {item.date && (
                  <p class="media-date">
                    Julkaistu: {item.date.toLocaleDateString("fi-FI")}
                  </p>
                )}
                {item.excerpt && <p class="media-excerpt">{item.excerpt}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </article>
  </main>
</Layout>

<style>
  .mark {
    margin: 0 0 0.35rem;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .media-list {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .media-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 20px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .media-thumb {
    flex: 0 0 260px;
  }

  .media-thumb iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .media-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .media-title {
    margin: 0 0 6px;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .media-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .media-title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .media-date {
    margin: 0 0 8px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .media-excerpt {
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .media-item {
      flex-direction: column;
      gap: 12px;
    }

    .media-thumb {
      flex: 1 1 auto;
      width: 100%;
    }
  }
</style>
