---
import Layout from "../../layouts/Layout.astro";
import MediaSidebar from "../../components/MediaSidebar.astro";
import { listMedia } from "../../data/media-loader";
import { withBase } from "../../data/nav";

const posts = await listMedia();

const items = posts.map((post) => {
  const video = post.body?.match(
    /youtube-nocookie\.com\/embed\/([A-Za-z0-9_-]+)/,
  )?.[1];
  const excerpt = (post.body ?? "")
    .split("\n")
    .map((line) => line.trim())
    .find((line) => line.length > 0 && !line.startsWith("<") && !line.startsWith("["));
  const date = post.data.date;
  return {
    id: post.id,
    title: post.data.title,
    date,
    video,
    excerpt,
    i18n: {
      title: { fi: post.data.title, sv: post.data.title_sv, en: post.data.title_en },
      excerpt: { fi: excerpt, sv: post.data.excerpt_sv, en: post.data.excerpt_en },
      date: date
        ? {
            fi: date.toLocaleDateString("fi-FI"),
            sv: date.toLocaleDateString("sv-SE"),
            en: date.toLocaleDateString("en-GB"),
          }
        : null,
    },
  };
});

// Per-post translations for the client-side language switcher (title/excerpt/date
// text only — the linked PDF/video and full article body stay Finnish-only).
const mediaText = Object.fromEntries(items.map((item) => [item.id, item.i18n]));

const navItems = posts.map((item) => ({
  id: item.id,
  title: item.data.title,
  date: item.data.date,
}));
---

<Layout
  title="Media — BETK"
  description="Artikkelit, blogitekstit, webinaarit ja julkaisut, joissa BETK on ollut esillä."
>
  <main id="main" class="sov-layout">
    <MediaSidebar items={navItems} />
    <article class="sov-document">
      <header class="sov-header">
        <p class="mark" data-i18n="nav.media">Media</p>
        <h1 class="sov-title" data-i18n="nav.media">Media</h1>
        <p class="sov-subtitle" data-i18n="media.subtitle">
          Artikkelit, blogitekstit, webinaarit ja julkaisut, joissa BETK on
          ollut esillä. Uusin ylimpänä.
        </p>
      </header>

      <ul class="media-list">
        {
          items.map((item) => (
            <li class="media-item">
              {item.video && (
                <div class="media-thumb">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${item.video}`}
                    title={item.title}
                    loading="lazy"
                    allowfullscreen
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  />
                </div>
              )}
              <div class="media-body">
                <h2 class="media-title">
                  <a href={withBase(`media/${item.id}`)} data-media-title={item.id}>{item.title}</a>
                </h2>
                {item.date && (
                  <p class="media-date">
                    <span data-i18n="media.published">Julkaistu:</span>{" "}
                    <time datetime={item.date.toISOString().slice(0, 10)} data-media-date={item.id}>
                      {item.i18n.date?.fi}
                    </time>
                  </p>
                )}
                {item.excerpt && <p class="media-excerpt" data-media-excerpt={item.id}>{item.excerpt}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </article>
  </main>
</Layout>

<script define:vars={{ mediaText }}>
  // Translates per-post title/excerpt/date on the Media listing when the
  // site language switches (fi/sv/en). Reuses the global language state
  // exposed by Layout.astro (window.betkGetLang / "betk-lang-change") —
  // this is content, not site chrome, so it isn't part of the shared
  // translations dictionary in i18n.ts.
  function applyMediaLang(lang) {
    document.querySelectorAll("[data-media-title]").forEach((el) => {
      const id = el.getAttribute("data-media-title");
      const entry = mediaText[id]?.title;
      if (entry) el.textContent = entry[lang] || entry.fi;
    });
    document.querySelectorAll("[data-media-excerpt]").forEach((el) => {
      const id = el.getAttribute("data-media-excerpt");
      const entry = mediaText[id]?.excerpt;
      if (entry) el.textContent = entry[lang] || entry.fi;
    });
    document.querySelectorAll("[data-media-date]").forEach((el) => {
      const id = el.getAttribute("data-media-date");
      const entry = mediaText[id]?.date;
      if (entry) el.textContent = entry[lang] || entry.fi;
    });
  }

  applyMediaLang(window.betkGetLang ? window.betkGetLang() : "fi");
  window.addEventListener("betk-lang-change", (e) => applyMediaLang(e.detail));
</script>

<style>
  .mark {
    margin: 0 0 0.35rem;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .media-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .media-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 12px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .media-thumb {
    flex: 0 0 132px;
  }

  .media-thumb iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .media-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .media-title {
    margin: 0 0 2px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .media-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .media-title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .media-date {
    margin: 0 0 4px;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .media-excerpt {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 700px) {
    .media-item {
      flex-direction: column;
      gap: 8px;
    }

    .media-thumb {
      flex: 1 1 auto;
      width: 100%;
      max-width: 16rem;
    }
  }
</style>
