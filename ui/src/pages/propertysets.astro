---
import { withBase } from "../data/nav";

const target = withBase("properties");
const canonical = Astro.site ? new URL(target, Astro.site).href : target;
---

<html lang="fi">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={canonical} />
		<title>BETK — Ominaisuusryhmät</title>
		<script is:inline define:vars={{ target }}>
			location.replace(target + location.hash + location.search);
		</script>
	</head>
	<body>
		<p><a href={target}>Ominaisuudet</a></p>
	</body>
</html>
