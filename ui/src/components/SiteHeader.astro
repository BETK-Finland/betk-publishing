---
import { filesNav, headlines, isNavLink, withBase } from "../data/nav";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const home = withBase("");
const logo = withBase("betk-logo.svg");

const isCurrent = (href: string) => {
  if (href.startsWith("/#") || href.startsWith("#")) return false;
  const url = href.replace(/\/$/, "") || "/";
  if (url === "/" || url === home.replace(/\/$/, "") || url === "") {
    return path === "/" || path === "";
  }
  return path === url || path.startsWith(`${url}/`);
};

const groupCurrent = (hrefs: string[]) => hrefs.some((href) => isCurrent(href));
---

<a class="skip" href="#main" data-i18n="nav.skip">Siirry sisältöön</a>
<header class="site">
  <div class="site-inner">
    <a class="brand" href={home}>
      <img src={logo} width="22" height="22" alt="" />
      <span>BETK</span>
    </a>
    <nav aria-label="Sivusto">
      {
        headlines.map((item) =>
          isNavLink(item) ? (
            <a
              href={item.href}
              class:list={[{ current: isCurrent(item.href) }]}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              data-i18n={item.i18nKey}
            >
              {item.label}
            </a>
          ) : (
            <div
              class:list={[
                "menu",
                { current: groupCurrent(item.children.map((child) => child.href)) },
                { wide: item.i18nKey === "nav.documents" },
              ]}
            >
              <button type="button" aria-haspopup="true" aria-expanded="false">
                <span data-i18n={item.i18nKey}>{item.label}</span>
                <svg class="chevron" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.5 4.5 6 8l3.5-3.5"
                  ></path>
                </svg>
              </button>
              <ul class="panel">
                {item.children.map((child) => (
                  <li data-sov-lang={child.lang}>
                    <a
                      href={child.href}
                      class:list={[{ current: isCurrent(child.href) }]}
                      aria-current={isCurrent(child.href) ? "page" : undefined}
                      data-i18n={child.i18nKey}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ),
        )
      }
    </nav>
    <div class="end">
      <div class="lang-switcher" aria-label="Kielivalinta">
        <button class="lang-btn" type="button" data-lang="fi">FI</button>
        <button class="lang-btn" type="button" data-lang="sv">SV</button>
        <button class="lang-btn" type="button" data-lang="en">EN</button>
      </div>
      <a class:list={["files", { current: isCurrent(filesNav.href) }]} href={filesNav.href}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linejoin="round"
            d="M4.25 2.25h5.1L12.75 5.65v8.1H4.25v-11.5Z"
          ></path>
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linejoin="round"
            d="M9.25 2.25v3.5h3.5"
          ></path>
        </svg>
        <span data-i18n={filesNav.i18nKey}>{filesNav.label}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: 0.75rem;
    top: -2.6rem;
    z-index: 50;
    padding: 0.3rem 0.55rem;
    background: var(--bg);
    color: var(--ink);
  }

  .skip:focus {
    top: 0.5rem;
  }

  .site {
    position: sticky;
    top: 0;
    z-index: 40;
    overflow: visible;
    border-bottom: 1px solid var(--line);
  }

  .site::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(14px);
  }

  .site-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.8rem 1.5rem;
  }

  .brand {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .brand img {
    display: block;
  }

  nav {
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35rem 1.25rem;
    font-size: 0.88rem;
  }

  nav a,
  nav button {
    color: var(--muted);
    font: inherit;
    font-size: inherit;
  }

  nav a:hover,
  .brand:hover,
  .files:hover {
    text-decoration: none;
  }

  nav a.current,
  nav .menu.current button,
  .files.current {
    color: var(--ink);
  }

  .menu {
    position: relative;
  }

  .menu button {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .chevron {
    display: block;
    flex-shrink: 0;
    transform-origin: 50% 50%;
    transition: transform 0.18s ease;
  }

  .menu.open .chevron {
    transform: rotate(180deg);
  }

  .panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: none;
    list-style: none;
    margin: 0;
    min-width: 14rem;
    max-width: 22rem;
    padding: 0.45rem 0;
    background: var(--bg);
    border: 1px solid var(--line);
  }

  .panel li {
    margin: 0;
  }

  .panel a {
    display: block;
    padding: 0.35rem 0.85rem;
    white-space: normal;
    line-height: 1.3;
  }

  .menu.wide .panel {
    min-width: 28rem;
    max-width: 36rem;
  }

  .menu.open .panel {
    display: block;
  }

  .end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .files {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .files svg {
    display: block;
    flex-shrink: 0;
  }

  .lang-switcher {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .lang-btn {
    padding: 3px 8px;
    font-size: 11px;
    font-family: var(--font-sans);
    letter-spacing: 0.06em;
    font-weight: 500;
    background: none;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--muted);
    cursor: pointer;
    transition: color 120ms, border-color 120ms, background 120ms;
  }

  .lang-btn:hover {
    color: var(--ink);
    border-color: var(--muted);
  }

  .lang-btn.active {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  @media (max-width: 768px) {
    .site-inner {
      grid-template-columns: 1fr auto;
      padding: 0.75rem 1.25rem;
    }

    nav {
      grid-column: 1 / -1;
      justify-self: stretch;
      order: 3;
    }

    .end {
      justify-self: end;
    }

    .panel {
      left: 0;
      transform: none;
    }

    .menu.wide .panel {
      min-width: 0;
      max-width: calc(100vw - 2.5rem);
    }
  }

  @media print {
    .skip,
    .site {
      display: none;
    }
  }
</style>

<script>
  const menus = [...document.querySelectorAll(".menu")];

  const setOpen = (menu: Element, open: boolean) => {
    menu.classList.toggle("open", open);
    menu.querySelector("button")?.setAttribute("aria-expanded", String(open));
  };

  const closeAll = (except?: Element) => {
    for (const menu of menus) {
      if (menu !== except) setOpen(menu, false);
    }
  };

  for (const menu of menus) {
    const button = menu.querySelector("button");
    if (!(button instanceof HTMLButtonElement)) continue;

    button.addEventListener("click", (event) => {
      event.stopPropagation();
      const open = !menu.classList.contains("open");
      closeAll(menu);
      setOpen(menu, open);
    });
  }

  document.addEventListener("click", () => closeAll());

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAll();
  });
</script>
