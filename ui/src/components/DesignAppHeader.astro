---
import { designApplications, defaultDesignApplication } from "../data/loader";

const defaultLabel =
	designApplications.find((app) => app.id === defaultDesignApplication)?.label ??
	designApplications[0]?.label ??
	"";
---

<th data-column="designApp" class="design-app-header">
	<label class="design-app-label">
		<span class="design-app-experimental">Suunnitteluohjelma, kokeellinen</span>
		<span class="design-app-control">
			<span class="design-app-shown">{defaultLabel}</span>
			<svg class="design-app-caret" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
				<path
					fill="none"
					stroke="currentColor"
					stroke-width="1.4"
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M2.5 4.5 6 8l3.5-3.5"
				></path>
			</svg>
			<select class="design-app-select">
				{designApplications.map((app) => (
					<option value={app.id} selected={app.id === defaultDesignApplication}>
						{app.label}
					</option>
				))}
			</select>
		</span>
	</label>
</th>
