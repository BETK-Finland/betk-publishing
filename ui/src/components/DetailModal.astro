---
// Single modal instance, populated at click-time from the <template> that
// each ProductRow renders alongside its Tiedot button.
---

<div
	id="detail-modal"
	class="modal"
	hidden
	role="dialog"
	aria-modal="true"
	aria-labelledby="detail-title"
>
	<div class="modal-backdrop" data-close></div>
	<div class="modal-panel" role="document">
		<button
			type="button"
			class="modal-close"
			aria-label="Sulje"
			data-close
		>×</button>
		<div class="modal-content" id="modal-content"></div>
	</div>
</div>

<style is:global>
	body.modal-open {
		overflow: hidden;
	}

	.modal[hidden] {
		display: none;
	}

	.modal {
		position: fixed;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		z-index: 50;
	}

	.modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(8, 8, 20, 0.72);
		backdrop-filter: blur(2px);
		cursor: pointer;
	}

	.modal-panel {
		position: relative;
		background: var(--surface);
		border: 1px solid var(--separator);
		border-radius: 8px;
		max-width: 880px;
		width: 100%;
		max-height: calc(100vh - 48px);
		overflow-y: auto;
		padding: 28px 32px 32px;
		box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
	}

	.modal-close {
		position: absolute;
		top: 10px;
		right: 12px;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		border: 1px solid var(--separator);
		background: transparent;
		color: var(--text-muted);
		font-size: 18px;
		line-height: 1;
		cursor: pointer;
		transition: background 120ms, color 120ms;
	}

	.modal-close:hover {
		background: var(--surface-raised);
		color: var(--accent-blue);
	}

	/* Detail content -------------------------------------------------------- */

	.detail-title {
		font-size: 20px;
		margin: 0 0 14px;
		color: var(--text-strong);
		letter-spacing: 0.02em;
	}

	.detail-subtitle {
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin: 20px 0 10px;
		font-weight: 500;
	}

	.detail-description {
		margin: 0;
		color: var(--text);
		line-height: 1.55;
	}

	.detail-empty {
		color: var(--text-muted);
		font-style: italic;
	}

	.detail-property-table {
		margin: 0;
		table-layout: fixed;
		width: 100%;
	}

	.detail-property-table .col-betk {
		width: 28%;
	}

	.detail-property-table .col-bec {
		width: 22%;
	}

	.detail-property-table .col-design-app {
		width: 34%;
	}

	.detail-property-table .col-type {
		width: 16%;
	}

	.detail-property-table .cell-mono,
	.detail-property-table .cell-name {
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.detail-property-table .design-app-header {
		min-width: 0;
		white-space: normal;
	}

	.property-group-row th {
		padding: 12px 10px 6px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: none;
		color: var(--accent-teal);
		background: var(--surface);
		border-bottom: 1px solid var(--separator);
	}
</style>

<script>
	const modal = document.getElementById("detail-modal") as HTMLElement | null;
	const content = document.getElementById("modal-content") as HTMLElement | null;

	if (modal && content) {
		const open = (row: HTMLElement) => {
			const tpl = row.querySelector<HTMLTemplateElement>(".product-detail");
			if (!tpl) return;
			content.replaceChildren(tpl.content.cloneNode(true));
			modal.hidden = false;
			document.body.classList.add("modal-open");
			document.dispatchEvent(new Event("betk-detail-open"));
			// Move focus to the close button so Escape feels natural.
			modal.querySelector<HTMLButtonElement>(".modal-close")?.focus();
		};

		const close = () => {
			modal.hidden = true;
			content.replaceChildren();
			document.body.classList.remove("modal-open");
		};

		document
			.querySelectorAll<HTMLButtonElement>(".detail-button")
			.forEach((btn) => {
				btn.addEventListener("click", (event) => {
					event.stopPropagation(); // don't bubble into tree-header toggle
					const row = btn.closest<HTMLElement>(".product-row");
					if (row) open(row);
				});
			});

		modal
			.querySelectorAll<HTMLElement>("[data-close]")
			.forEach((el) => el.addEventListener("click", close));

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && !modal.hidden) close();
		});
	}
</script>
