---
interface Props {
  id: string;
  sectionNumber: string;
  title: string;
  isDraft?: boolean;
}
const { id, sectionNumber, title, isDraft = false } = Astro.props;
const headingTag = sectionNumber.includes(".") ? "h4" : "h2";
---

<section id={id} class="sov-section">
  {(sectionNumber || title) && (headingTag === "h2" ? (
    <h2>{sectionNumber} {title}</h2>
  ) : (
    <h4>{sectionNumber} {title}</h4>
  ))}
  <div class={`sov-prose${isDraft ? " sov-prose--draft" : ""}`}>
    <slot />
  </div>
</section>
