---
import {
	propertySetsByDiscipline,
	designAppAttrs,
	designAppSources,
	designAppValue,
	defaultDesignApplication,
} from "../data/loader";
import { propertySetAnchor } from "../data/anchors";
import { withBase } from "../data/nav";
import { getTietovirratPayload } from "../data/tietovirrat";
import DesignAppHeader from "./DesignAppHeader.astro";

const traceByGroup = new Map(
	getTietovirratPayload().propertySetTraces.map((t) => [t.group, t]),
);
---

<div
	class="property-set-list catalog-off"
	data-view="OMINAISUUSRYHMÄT"
	data-default-design-app={defaultDesignApplication}
>
	{propertySetsByDiscipline.map((disc) => (
		<section class="node discipline-node open" data-node="discipline">
			<h2 class="catalog-heading">{disc.label}</h2>
			<div class="node-body">
				{disc.sets.map((set) => {
					const trace = traceByGroup.get(set.group);
					return (
					<section class="node" data-node="propertyset" id={propertySetAnchor(disc.discipline, set.group)}>
						<header class="node-header propertyset-header" role="button" tabindex="0" aria-expanded="false">
							<span class="caret" aria-hidden="true"></span>
							<h3>{set.group}</h3>
							<span class="count">{set.properties.length}</span>
							{trace && (
								<a
									href={withBase(`tietovirrat?pset=${trace.id}`)}
									class="pset-trace-link"
									title={`Seuraa ominaisuusryhmää "${set.group}" 3D-tietovirtamallissa`}
								>
									3D-tietovirta →
								</a>
							)}
						</header>
						<div class="node-body">
							<table class="product-table property-set-table">
								<thead>
									<tr>
										<th data-column="label">LABEL</th>
										<th data-column="bec">BEC</th>
										<DesignAppHeader />
										<th data-column="ifcType">IFC PROPERTY TYPE</th>
										<th data-column="dataType">DATA TYPE</th>
										<th data-column="unit">UNIT</th>
										<th data-column="requirement">REQUIREMENT</th>
										<th data-column="exampleValue">EXAMPLE VALUE</th>
										<th data-column="allowedValues">ALLOWED VALUES</th>
										<th data-column="description">DESCRIPTION</th>
										<th data-column="propId">ID</th>
										<th data-column="propVersion">VERSION</th>
									</tr>
								</thead>
								<tbody>
									{set.properties.map((p) => (
										<tr
											class="property-set-row"
											data-search={[
												p.label,
												p.becProperty,
												p.id,
												p.description,
												set.group,
												...Object.values(designAppSources(p.id)),
											].filter(Boolean).join(" ").toLowerCase()}
										>
											<td data-column="label" class="cell-name">{p.label}</td>
											<td data-column="bec" class="cell-mono">{p.becProperty || "—"}</td>
											<td
												data-column="designApp"
												class="cell-mono cell-design-app"
												{...designAppAttrs(p.id)}
											>{designAppValue(p.id) || "—"}</td>
											<td data-column="ifcType" class="cell-mono">{p.ifcPropertyType || "—"}</td>
											<td data-column="dataType" class="cell-mono">{p.dataType || "—"}</td>
											<td data-column="unit" class="cell-mono">{p.unit || "—"}</td>
											<td data-column="requirement">{p.requirement || "—"}</td>
											<td data-column="exampleValue" class="cell-mono">{p.exampleValue || "—"}</td>
											<td data-column="allowedValues">{p.allowedValues || "—"}</td>
											<td data-column="description" class="cell-description">{p.description || "—"}</td>
											<td data-column="propId" class="cell-mono">{p.id || "—"}</td>
											<td data-column="propVersion" class="cell-mono">{p.version || "—"}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
					);
				})}
			</div>
		</section>
	))}
</div>

<script>
	import { initDesignAppColumn } from "../scripts/design-app";

	const root = document.querySelector<HTMLElement>(".property-set-list");
	initDesignAppColumn(root?.dataset.defaultDesignApp || "tekla");

	function toggleNode(header: HTMLElement) {
		const node = header.closest<HTMLElement>(".node");
		if (!node) return;
		const isOpen = node.classList.toggle("open");
		header.setAttribute("aria-expanded", String(isOpen));
	}

	document.querySelectorAll<HTMLElement>(".property-set-list .propertyset-header").forEach((header) => {
		header.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest(".pset-trace-link")) {
				return;
			}
			toggleNode(header);
		});
		header.addEventListener("keydown", (event) => {
			if ((event.target as HTMLElement).closest(".pset-trace-link")) {
				return;
			}
			if (event.key === "Enter" || event.key === " ") {
				event.preventDefault();
				toggleNode(header);
			}
		});
	});

	function openTargetHash() {
		const hashId = decodeURIComponent(location.hash.slice(1));
		if (!hashId.startsWith("pset-")) return;
		const targetNode = document.getElementById(hashId);
		if (!targetNode) return;
		targetNode.classList.add("open");
		targetNode
			.querySelector(":scope > .propertyset-header")
			?.setAttribute("aria-expanded", "true");
	}

	openTargetHash();
	window.addEventListener("hashchange", openTargetHash);
</script>

<style>
	.pset-trace-link {
		margin-left: auto;
		padding: 2px 8px;
		border-radius: 4px;
		border: 1px solid var(--line, #cbd5e1);
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--accent-teal, #0284c7);
		text-decoration: none;
		white-space: nowrap;
	}

	.pset-trace-link:hover {
		background: var(--surface-raised, rgba(2, 132, 199, 0.08));
		text-decoration: underline;
	}
</style>
