---
import { withBase } from "../data/nav";

interface Item {
  id: string;
  title: string;
  date?: Date;
}

interface Props {
  items: Item[];
  current?: string;
}

const { items, current } = Astro.props;
---

<aside class="sov-sidebar">
  <nav class="sov-doc-nav" aria-label="Media">
    <p class="sidebar-heading" data-i18n="media.heading">MEDIA</p>
    <ul class="sov-toc-list">
      {
        items.map((item) => (
          <li>
            <a
              class:list={["sov-toc-link", "media-nav-link", { active: item.id === current }]}
              href={withBase(`media/${item.id}`)}
            >
              <span class="media-nav-title">{item.title}</span>
              {item.date && (
                <time class="media-nav-date" datetime={item.date.toISOString().slice(0, 10)}>
                  {item.date.toLocaleDateString("fi-FI")}
                </time>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<style>
  .media-nav-link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.12rem;
    padding: 0.35rem 0.5rem;
    line-height: 1.3;
  }

  .media-nav-title {
    overflow-wrap: anywhere;
  }

  .media-nav-date {
    color: var(--muted);
    font-size: 11px;
  }
</style>
