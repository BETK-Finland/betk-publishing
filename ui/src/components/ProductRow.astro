---
import type { Product } from "../data/types";
import { resolveProductProperties, designAppAttrs, designAppValue } from "../data/loader";
import { productAnchor } from "../data/anchors";
import DesignAppHeader from "./DesignAppHeader.astro";

interface Props {
	product: Product;
}

const { product } = Astro.props;
const groups = resolveProductProperties(product);
const searchText = [
  product.name,
  product.generalId,
  product.id,
  product.description,
  product.uri,
].filter(Boolean).join(" ").toLowerCase();
---

<tr class="product-row" id={productAnchor(product.name)} data-product-id={product.id || product.generalId} data-search={searchText}>
	<td data-column="name" class="cell-name">{product.name}</td>
	<td data-column="generalId" class="cell-mono">{product.generalId}</td>
	<td data-column="version" class="cell-mono">{product.version}</td>
	<td data-column="id" class="cell-mono">{product.id || "—"}</td>
	<td data-column="uri" class="cell-uri">
		{product.uri
			? <a href={product.uri} target="_blank" rel="noopener">{product.uri}</a>
			: "—"}
	</td>
	<td data-column="description" class="cell-description">{product.description || "—"}</td>
	<td class="cell-actions">
		<button type="button" class="detail-button" data-product={product.generalId}>
			Tiedot
		</button>
		<template class="product-detail">
			<h2 class="detail-title">{product.name}</h2>
			{product.description && (
				<section class="detail-description-block">
					<h3 class="detail-subtitle">KUVAUS</h3>
					<p class="detail-description">{product.description}</p>
				</section>
			)}
			{product.examples && (
				<section class="detail-examples-block">
					<h3 class="detail-subtitle">ESIMERKIT</h3>
					<p class="detail-description">{product.examples}</p>
				</section>
			)}
			<section class="detail-properties-block">
				<h3 class="detail-subtitle">
					TUOTEOSAN VAADITUT OMINAISUUDET (Property Set + Property)
				</h3>
				{groups.length === 0 && (
					<p class="detail-empty">Ei määriteltyjä ominaisuuksia.</p>
				)}
				{groups.length > 0 && (
					<table class="product-table detail-property-table">
						<colgroup>
							<col class="col-betk" />
							<col class="col-bec" />
							<col class="col-design-app" />
							<col class="col-type" />
						</colgroup>
						<thead>
							<tr>
								<th>BETK</th>
								<th>BEC</th>
								<DesignAppHeader />
								<th>TYPE</th>
							</tr>
						</thead>
						<tbody>
							{groups.map((g) => (
								<>
									<tr class="property-group-row">
										<th colspan="4">{g.group}</th>
									</tr>
									{g.properties.map((prop) => (
										<tr>
											<td class="cell-name">{prop.label}</td>
											<td class="cell-mono">{prop.becProperty || "—"}</td>
											<td
												data-column="designApp"
												class="cell-mono cell-design-app"
												{...designAppAttrs(prop.id)}
											>{designAppValue(prop.id) || "—"}</td>
											<td class="cell-mono">{prop.ifcPropertyType || "—"}</td>
										</tr>
									))}
								</>
							))}
						</tbody>
					</table>
				)}
			</section>
		</template>
	</td>
</tr>
