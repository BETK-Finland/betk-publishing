---
import type { DocumentMeta } from "../data/soveltamisohje-types";
import { sovStrings } from "../data/soveltamisohje-i18n";

interface Props {
  meta: DocumentMeta;
  lang?: string;
}

const { meta, lang } = Astro.props;
const t = sovStrings(lang);
const { otsikko, alaotsikko, julkaisija, paivamaara, versio, status, versiohistoria, laatijat } = meta;
---

<header class="sov-header">
  <h1 class="sov-title">{otsikko}</h1>
  <p class="sov-subtitle"><strong>{alaotsikko}</strong></p>
  <div class="sov-meta">
    <p>{t.publisher}: {julkaisija}</p>
    <p>{t.date}: {paivamaara}</p>
    <p>{t.version}: {versio} &middot; {t.status}: {status}</p>
  </div>
  <p class="sov-print-date" aria-hidden="true"></p>

  <details class="sov-details">
    <summary>{t.docVersion}</summary>
    <table class="sov-meta-table">
      <thead>
        <tr><th>{t.version}</th><th>{t.date}</th><th>{t.author}</th><th>{t.change}</th></tr>
      </thead>
      <tbody>
        {versiohistoria.map(v => (
          <tr><td>{v.versio}</td><td>{v.paivamaara}</td><td>{v.tekija}</td><td>{v.kuvaus}</td></tr>
        ))}
      </tbody>
    </table>
  </details>

  <details class="sov-details">
    <summary>{t.authors}</summary>
    <table class="sov-meta-table">
      <thead>
        <tr><th>{t.name}</th><th>{t.organisation}</th></tr>
      </thead>
      <tbody>
        {laatijat.map(l => (
          <tr><td>{l.nimi}</td><td>{l.organisaatio}</td></tr>
        ))}
      </tbody>
    </table>
  </details>
</header>
