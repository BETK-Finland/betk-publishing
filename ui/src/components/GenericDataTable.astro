---
import type { GenericTaulukot } from "../data/soveltamisohje-types";

import { sovStrings } from "../data/soveltamisohje-i18n";

interface Props {
  data: GenericTaulukot;
  lang?: string;
}
const { data, lang } = Astro.props;
const t = sovStrings(lang);
---

{data.taulukot.map(tb => (
  <div class="sov-datatable">
    <p class="sov-table-number">{t.table} {tb.taulukonNumero}. {tb.otsikko}</p>
    <table class="sov-values-table">
      <caption class="sr-only">{t.table} {tb.taulukonNumero}. {tb.otsikko}</caption>
      <thead>
        <tr>
          {tb.sarakkeet.map(s => <th>{s}</th>)}
        </tr>
      </thead>
      <tbody>
        {tb.rivit.map(r => (
          <tr>
            {r.cells.map(c => <td set:html={c} />)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
))}
