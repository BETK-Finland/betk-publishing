---
interface Section {
  label: string;
}

interface Props {
  sections: Section[];
  heading?: string;
}

const { sections, heading = "Sisällysluettelo" } = Astro.props;
---

<div class="sov-print-toc">
  <h2>{heading}</h2>
  <ol class="sov-print-toc-list">
    {sections.map(s => <li>{s.label}</li>)}
  </ol>
</div>
